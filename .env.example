# Full walkthrough: SETUP.md

# Postgres connection string (local docker-compose: see below; production: Railway's PUBLIC URL)
DATABASE_URL="postgresql://mams:mams@localhost:5433/mams"
# Used by the Vitest suite; it is wiped on every run, so never point it at real data
TEST_DATABASE_URL="postgresql://mams:mams@localhost:5433/mams_test"

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# The address people use to reach the site (https in production). Verification links are built from it.
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend). Leave RESEND_API_KEY empty in development and verification emails are printed in the terminal.
# In production both are required, and EMAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""            # e.g. "MAMS Prediction Market <noreply@mail.example.com>"

# Site settings
MAMS_OWNER="Kaushik"     # username of the site owner (can't be overridden by other admins)
MAMS_ADMINS=""           # comma-separated usernames that become admins when they sign up
MAMS_TZ="America/New_York"

# Protects /api/cron/finalize (Vercel sets this automatically for cron calls when defined)
CRON_SECRET=""
