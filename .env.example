# Postgres connection string (local docker-compose: see below; production: Railway's public URL)
DATABASE_URL="postgresql://mams:mams@localhost:5433/mams"
# Used by the Vitest suite; it is wiped on every run, so never point it at real data
TEST_DATABASE_URL="postgresql://mams:mams@localhost:5433/mams_test"

# better-auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Site settings
MAMS_OWNER="Kaushik"     # username of the site owner (can't be overridden by other admins)
MAMS_ADMINS=""           # comma-separated usernames that become admins when they sign up
MAMS_TZ="America/New_York"

# Protects /api/cron/finalize (Vercel sets this automatically for cron calls when defined)
CRON_SECRET=""
